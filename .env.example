# ── Database (Neon PostgreSQL) ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Get this from: https://console.neon.tech → your project → Connection Details

# ── Auth (JWT) ──────────────────────────────────────────────────────────────
JWT_SECRET=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── Admin Role ──────────────────────────────────────────────────────────────
ADMIN_EMAIL=
# The email that gets admin role automatically on first signup

# ── Image Storage (Vercel Blob) ──────────────────────────────────────────────
VITE_BLOB_BASE_URL=https://your-store.public.blob.vercel-storage.com
BLOB_READ_WRITE_TOKEN=
# Get from: https://vercel.com/dashboard → Storage → your blob store → Tokens
